[MASTER]
ignore=.venv
persistent=yes

[MESSAGES CONTROL]
disable=
    C0114,  # missing-module-docstring
    C0115,  # missing-class-docstring
    C0116,  # missing-function-docstring
    C0301,  # line-too-long
    C0411,  # wrong-import-order (let isort handle this)
    W0611,  # unused-import
    R0903,   # too-few-public-methods
    W1203,
    W0613,
    W0201

[FORMAT]
max-line-length=120

[DESIGN]
max-attributes=12
max-args=12
max-positional-arguments=12
