        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="password and username grabber">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import org.apache.jmeter.services.FileServer

def baseDir = FileServer.getFileServer().getBaseDir()
def file = new File(baseDir + &quot;/../TestData/registered_users.csv&quot;)

if (!file.exists()) {
    throw new Exception(&quot;CSV NOT FOUND at: &quot; + file.getAbsolutePath())
}

def lines = file.readLines().drop(1)

// Trim each field to remove whitespace
def users = lines.collect { line -&gt;
    def parts = line.split(&apos;,&apos;).collect { it.trim() }
    return parts
}

// Store once in props
props.put(&apos;usersList&apos;, users)

// Retrieve
def storedUsers = props.get(&apos;usersList&apos;)

// Pick random user
def randomUser = storedUsers[new Random().nextInt(storedUsers.size())]

// Assign trimmed values to JMeter variables
vars.put(&apos;username&apos;, randomUser[0])
vars.put(&apos;password&apos;, randomUser[1])</stringProp>
        </JSR223PreProcessor>
