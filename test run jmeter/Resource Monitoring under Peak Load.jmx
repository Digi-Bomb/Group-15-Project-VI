        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="first name randomizer">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def firstNames = [&quot;John&quot;, &quot;Jane&quot;, &quot;Alex&quot;, &quot;Emily&quot;, &quot;Chris&quot;, &quot;Taylor&quot;, &quot;Jordan&quot;, &quot;Morgan&quot;]

def rand = new Random()
def first = firstNames[rand.nextInt(firstNames.size())]

vars.put(&quot;first&quot;, first)</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="last name randomizer">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def lastNames = [&quot;Smith&quot;, &quot;Johnson&quot;, &quot;Williams&quot;, &quot;Brown&quot;, &quot;Garcia&quot;, &quot;Miller&quot;, &quot;Rodriguez&quot;, &quot;Harris&quot;]

def rand = new Random()
def last = lastNames[rand.nextInt(lastNames.size())]

vars.put(&quot;last&quot;, last)</stringProp>
        </JSR223PreProcessor>
