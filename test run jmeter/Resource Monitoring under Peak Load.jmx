        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="user registry">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.util.Random
import org.apache.jmeter.services.FileServer

def baseDir = FileServer.getFileServer().getBaseDir()

def rand = new Random()

def genusername = &quot;user_&quot; + rand.nextInt(1000000)
def genpassword = &quot;pass_&quot; + rand.nextInt(1000000)

// Store variables
vars.put(&quot;username&quot;, genusername)
vars.put(&quot;password&quot;, genpassword)

// Define file path relative to JMeter base dir
def file = new File(baseDir, &quot;../TestData/registered_users.csv&quot;)

// Ensure parent directory exists
file.getParentFile().mkdirs()

// Create file + header if not exists
if (!file.exists()) {
    file &lt;&lt; &quot;username,password\n&quot;
}

// Append data
file &lt;&lt; &quot;${genusername},${genpassword}\n&quot;

log.info(&quot;Generated user: &quot; + genusername)</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
